meta {
  name: 创建视图
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/views
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "table_id": "{{table_id}}",
    "name": "测试视图",
    "type": "grid"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const r = res.getBody();
    bru.setEnvVar('view_id', r.data.id);
  }
}

settings {
  encodeUrl: true
}
