meta {
  name: 创建表
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/tables
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "测试表",
    "base_id": "{{base_id}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const r = res.getBody();
    bru.setEnvVar('table_id', r.data.id);
  }
}

settings {
  encodeUrl: true
}
