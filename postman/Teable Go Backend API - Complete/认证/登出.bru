meta {
  name: 登出
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/auth/logout
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

settings {
  encodeUrl: true
}
