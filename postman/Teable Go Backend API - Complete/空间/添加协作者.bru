meta {
  name: 添加协作者
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/spaces/{{space_id}}/collaborators
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "email": "collaborator@example.com",
    "role": "member"
  }
}

settings {
  encodeUrl: true
}
