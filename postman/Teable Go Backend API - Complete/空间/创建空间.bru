meta {
  name: 创建空间
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/spaces
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "测试工作空间"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const r = res.getBody();
    bru.setEnvVar('space_id', r.data.id);
  }
}

settings {
  encodeUrl: true
}
